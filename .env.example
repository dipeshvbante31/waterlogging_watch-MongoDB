# Copy this file to .env for local development. Never commit your real .env.
WW_ENV=development
WW_LOG_LEVEL=INFO

# Database history: MongoDB Atlas (recommended for local + Render)
# Add your real Atlas URI locally in .env, and in Render Environment Variables.
MONGODB_URI=mongodb+srv://USERNAME:mongodb+srv://sagexrisky69_db_user:65HvrvCuyTjbxvYy@cluster0.iyzhrfs.mongodb.net/
MONGODB_DATABASE=sagexrisky69_db_user
MONGODB_COLLECTION=predictions

# If MONGODB_URI is not set, the app falls back to local SQLite.
WW_DATABASE_URL=sqlite:///./data/waterlogging.db
WW_SAVE_HISTORY=true

# Where model.joblib / metadata / metrics live
WW_MODELS_DIR=models

# Weather provider behaviour
WW_HTTP_TIMEOUT_S=10
WW_WEATHER_CACHE_TTL_S=1800
WW_WEATHER_STALE_TTL_S=86400

# Abuse protection (per client address, per process; 0 disables)
WW_RATE_LIMIT_PER_MINUTE=30
WW_MAX_BODY_BYTES=16384
